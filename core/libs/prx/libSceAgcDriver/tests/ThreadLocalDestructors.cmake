file(STRINGS "${OBJECT_LIST}" OBJECTS)
if(NOT OBJECTS)
    message(FATAL_ERROR "thread-local object list is empty")
endif()
set(found)
foreach(object IN LISTS OBJECTS)
    execute_process(COMMAND "${NM}" --undefined-only "${object}" OUTPUT_VARIABLE symbols RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${NM} failed on ${object}")
    endif()
    if(symbols MATCHES "__cxa_thread_atexit")
        list(APPEND found "${object}")
    endif()
endforeach()
if(found)
    list(JOIN found "\n  " listed)
    message(FATAL_ERROR "thread_local objects with destructors run on freed emutls storage on MinGW; use ShaderRecompiler::ThreadOwned or HostThreadLocal in:\n  ${listed}")
endif()
